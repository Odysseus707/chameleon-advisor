{"nodes": [{"id": "chi_edge_advisor_readme_chi_edge_advisor", "label": "chi-edge-advisor", "file_type": "concept", "source_file": "chi-edge-advisor/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allocation-aware resource advisor for CHI@Edge. Intentionally mirrors the RAG-docs-chameleon stack (FAISS, BAAI/bge-large-en-v1.5, OpenAI-compatible client to Tejas/Llama) so it can later be wrapped as an MCP server plugged into the chatbot. Probe, offline pipeline, and tests deliberately run stdlib-only; backend selection and API keys are never hardcoded, everything routes through advisor/config.py."}, {"id": "chi_edge_advisor_readme_pipeline", "label": "READ-RETRIEVE-REASON-VALIDATE-EMIT pipeline", "file_type": "rationale", "source_file": "chi-edge-advisor/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five function-shaped stages with append-only JSONL logging per stage so runs can be graded later; the stage shape was chosen so each stage can become an MCP tool (read_availability, retrieve_artifacts, reason, validate, emit)."}, {"id": "chi_edge_advisor_readme_probe_availability", "label": "probe_availability.py availability probe", "file_type": "concept", "source_file": "chi-edge-advisor/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First deliverable by design: empirically answers whether the Chameleon reference API reflects live reservation state. Verdict STATIC-ONLY \u2014 the reference API exposes zero CHI@Edge clusters/devices and no reservation fields, so both live availability and the edge hardware catalog must come from Blazar via python-chi."}, {"id": "chi_edge_advisor_readme_blazarbackend", "label": "BlazarBackend", "file_type": "concept", "source_file": "chi-edge-advisor/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live availability backend via python-chi; AVAILABILITY_BACKEND=blazar is the required setting for real use because the reference API has no live state."}, {"id": "chi_edge_advisor_readme_referenceapibackend", "label": "ReferenceApiBackend", "file_type": "concept", "source_file": "chi-edge-advisor/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept behind the same AvailabilityBackend interface as a static identity source; the backend is a config switch so nothing downstream cares which backend supplies live state, and no rewrite is needed if a live reference-API endpoint ever appears."}, {"id": "chi_edge_advisor_readme_trap_checks", "label": "CHI@Edge trap validation checks", "file_type": "rationale", "source_file": "chi-edge-advisor/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pass/fail checks for the known CHI@Edge gotchas: architecture mismatch (arm64 vs x86_64), device actually free in the window, machine_type/device_profile exist in inventory, platform_version present, runtime=nvidia when a GPU workload lands on a Jetson."}, {"id": "chi_edge_advisor_readme_spec_emitter", "label": "python-chi spec emitter", "file_type": "concept", "source_file": "chi-edge-advisor/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renders add_device_reservation + container.Container \u2014 not add_node_reservation/create_server, the two most common CHI@Edge API mistakes \u2014 and dry-checks the spec by constructing objects without submitting."}, {"id": "chi_edge_advisor_readme_python_chi", "label": "python-chi", "file_type": "concept", "source_file": "chi-edge-advisor/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "chi_edge_advisor_readme_chi_edge", "label": "CHI@Edge testbed", "file_type": "concept", "source_file": "chi-edge-advisor/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "chi_edge_advisor_readme_raspberrypi4_64", "label": "raspberrypi4-64 device type", "file_type": "concept", "source_file": "chi-edge-advisor/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "chi_edge_advisor_readme_chi_edge_advisor", "target": "chi_edge_advisor_readme_pipeline", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "chi-edge-advisor/README.md", "source_location": null, "weight": 1.0}, {"source": "chi_edge_advisor_readme_probe_availability", "target": "chi_edge_advisor_readme_blazarbackend", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "chi-edge-advisor/README.md", "source_location": null, "weight": 1.0}, {"source": "chi_edge_advisor_readme_chi_edge_advisor", "target": "chi_edge_advisor_readme_referenceapibackend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "chi-edge-advisor/README.md", "source_location": null, "weight": 1.0}, {"source": "chi_edge_advisor_readme_pipeline", "target": "chi_edge_advisor_readme_trap_checks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "chi-edge-advisor/README.md", "source_location": null, "weight": 1.0}, {"source": "chi_edge_advisor_readme_pipeline", "target": "chi_edge_advisor_readme_spec_emitter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "chi-edge-advisor/README.md", "source_location": null, "weight": 1.0}, {"source": "chi_edge_advisor_readme_spec_emitter", "target": "chi_edge_advisor_readme_python_chi", "relation": "references",