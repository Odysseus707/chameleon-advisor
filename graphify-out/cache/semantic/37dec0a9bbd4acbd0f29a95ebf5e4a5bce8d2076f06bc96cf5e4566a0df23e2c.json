{"nodes": [{"id": "grounding_edge_sensehat_image_readme_edge_sensehat_image", "label": "edge_sensehat_image artifact", "file_type": "concept", "source_file": "grounding/edge_sensehat_image/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One container image (ghcr.io/chameleoncloud/edge_sensehat_image:latest) serves two sense-hat boards: Part A RPi Sense HAT via the sense_hat library + pi_sensehat profile on iot-rpi4-picam3; Part B Waveshare Sense HAT (B) via Adafruit CircuitPython + pi_gpio profile on iot-rpi-cm4-02, with Blinka env-var workarounds (RPI_LGPIO_REVISION, BLINKA_FORCECHIP/FORCEBOARD) for the missing /sys/firmware/devicetree inside containers."}, {"id": "grounding_edge_sensehat_image_readme_pi_sensehat_profile", "label": "pi_sensehat device profile", "file_type": "concept", "source_file": "grounding/edge_sensehat_image/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exposes i2c, gpiomem, gpiochip, framebuffer /dev/fb0, and /dev/input event devices for the RPi Sense HAT."}, {"id": "grounding_edge_sensehat_image_readme_pi_gpio_profile", "label": "pi_gpio device profile", "file_type": "concept", "source_file": "grounding/edge_sensehat_image/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exposes i2c, gpiomem, and gpiochip devices for GPIO/I2C access (Waveshare Sense HAT path)."}], "edges": [{"source": "grounding_edge_sensehat_image_readme_edge_sensehat_image", "target": "grounding_edge_sensehat_image_readme_pi_sensehat_profile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "grounding/edge_sensehat_image/README.md", "source_location": null, "weight": 1.0}, {"source": "grounding_edge_sensehat_image_readme_edge_sensehat_image", "target": "grounding_edge_sensehat_image_readme