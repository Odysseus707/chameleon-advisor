_location": null, "weight": 1.0}], "hyperedges": [{"id": "advisor_room_integration_flow", "label": "Advisor room integration flow", "nodes": ["docs_architecture_architecture_and_integration_rag_docs_chameleon", "docs_architecture_architecture_and_integration_advisor_room", "docs_architecture_architecture_and_integration_should_fire_gate", "docs_architecture_architecture_and_integration_edge_resource_advisory_injection", "docs_architecture_architecture_and_integration_local_llm", "chi_edge_advisor_readme_chi_edge_advisor"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/architecture-and-integration.md"}]}