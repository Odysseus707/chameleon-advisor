{"nodes": [{"id": "benchmark_v4_benchmark_report", "label": "Benchmark v4 Session Report", "file_type": "document", "source_file": "benchmark_v4/BENCHMARK_REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_v4_tools_calibrate_v3", "label": "tools/calibrate_v3.py \u2014 Checker Calibration Tool", "file_type": "code", "source_file": "benchmark_v4/BENCHMARK_REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_v4_tools_make_run_prompts", "label": "tools/make_run_prompts.py \u2014 Run Prompt Generator", "file_type": "code", "source_file": "benchmark_v4/BENCHMARK_REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_v4_benchmark_report_calibration", "label": "Checker-vs-Human Calibration (Cohen's kappa on v3 cells)", "file_type": "concept", "source_file": "benchmark_v4/BENCHMARK_REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After code-fence recovery, agreement at human==2 rose 0.536 -> 0.893 and kappa 0.000 -> 0.783 (substantial agreement). Errors are one-directional the safe way: the checker essentially never rubber-stamps a bad answer; it models 'correct', not 'partially useful'."}, {"id": "benchmark_v4_benchmark_report_code_fence_recovery", "label": "Code-Fence Recovery (--wrap-code, ast.parse gate)", "file_type": "rationale", "source_file": "benchmark_v4/BENCHMARK_REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Excel paste stripped all code fences (0/84 kept), making kappa 0. Recovery is opt-in and self-validating: a candidate block is fenced only if it ast.parse()s as Python, so prose and bash/dockerfile blocks are left alone \u2014 no false code. Glued labels like 'pythonimport' are un-glued only on keyword/domain-root boundaries."}, {"id": "benchmark_v4_benchmark_report_checker_gaps", "label": "Checker Gaps P03/P08 (actionable false negatives)", "file_type": "concept", "source_file": "benchmark_v4/BENCHMARK_REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "P03 expects a machine_type/machine_name kwarg but accepted answers used add_device_reservation(devices=[...]); P08's execute/output capture tokens are under-specified. Fixing both would likely lift kappa(==2) toward ~0.85-0.9 but requires editing off-limits harness/checks.py."}], "edges": [{"source": "benchmark_v4_benchmark_report_calibration", "target": "benchmark_v4_harness_runner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "benchmark_v4/BENCHMARK_REPORT.md", "source_location": null, "weight": 1.0}, {"source": "benchmark_v4_tools_calibrate_v3", "target": "benchmark_v4_benchmark_report_calibration", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "benchmark_v4/BENCHMARK_REPORT.md", "source_location": null, "weight": 1.0}, {"source": "benchmark_v4_benchmark_report_code_fence_recovery", "target": "benchmark_v4_tools_calibrate_v3", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "benchmark_v4/BENCHMARK_REPORT.md", "source_location": null, "weight": 1.0}, {"source": "benchmark_v4_benchmark_report_checker_gaps", "target": "benchmark_v4_harness_checks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "benchmark_v4/BENCHMARK_REPORT.md", "source_location": null, "weight": 1.0}, {"source": "benchmark_v4_benchmark_report_checker_gaps", "target": "benchmark_v4_benchmark_report_calibration", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "benchmark_v4/BEN