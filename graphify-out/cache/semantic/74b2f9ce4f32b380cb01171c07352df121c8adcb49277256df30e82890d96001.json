{"nodes": [{"id": "benchmark_v4_readme", "label": "CHI@Edge Coding Benchmark v4 README", "file_type": "document", "source_file": "benchmark_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_v4_harness_runner", "label": "harness/runner.py \u2014 Answer Scorer", "file_type": "code", "source_file": "benchmark_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_v4_harness_checks", "label": "harness/checks.py \u2014 Checker Library", "file_type": "code", "source_file": "benchmark_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_v4_harness_validate_golds", "label": "harness/validate_golds.py \u2014 Gold Admission Gate", "file_type": "code", "source_file": "benchmark_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_v4_harness_tier_assign", "label": "harness/tier_assign.py \u2014 Computed Tier Assignment", "file_type": "code", "source_file": "benchmark_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_v4_tools_build_items", "label": "tools/build_items.py \u2014 Item Bank Single Source of Truth", "file_type": "code", "source_file": "benchmark_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_v4_readme_h0_h1_instrument", "label": "H0/H1 Group Instrument (mechanism/specifics/safety)", "file_type": "rationale", "source_file": "benchmark_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every check is tagged mechanism/specifics/safety and pass rates are reported per group per condition. Under held-out feeding, H1 (transfer) predicts mechanism checks pass while specifics fail; H0 (task-specific lookup) predicts both fail."}, {"id": "benchmark_v4_readme_gold_admission_gate", "label": "SWE-bench-Style Gold Admission Gate", "file_type": "rationale", "source_file": "benchmark_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A gold answer is admitted only after passing 100% of its own checkers \u2014 ground truth that cannot pass its own test is not ground truth. 50/50 golds pass; a 10-item negative-control suite proves the checks actually fire."}, {"id": "benchmark_v4_readme_computed_tiers", "label": "Computed Difficulty Tiers (key-token coverage)", "file_type": "rationale", "source_file": "benchmark_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tier_assign.py computes the tier of every (item, fed_set) pair from key-token coverage of the fed grounding files \u2014 tiers are measured, never asserted, inoculating against the 'hand-picked difficulty labels' critique. Only CHI@Edge-specific load-bearing, generation-agnostic tokens count."}, {"id": "benchmark_v4_readme_verification_levels", "label": "Verification Levels V0/V1/V2", "file_type": "rationale", "source_file": "benchmark_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V0 (46 items) static AST checking only; V1 (AV01-AV04) additionally executed against a Blazar snapshot via harness/stub_chi with stdout compared to expectations; V2 (live testbed execution) dropped this cycle by decision of the fellow \u2014 no lease is ever created, no testbed quota consumed, evaluation stays reproducible offline."}, {"id": "benchmark_v4_readme_synthetic_snapshot", "label": "Synthetic Blazar Snapshot", "file_type": "rationale", "source_file": "benchmark_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The shipped snapshot is synthetic and flagged in-file; it unblocks V1 harness development without pretending to have live data, but must be replaced by a recorded Blazar snapshot from the advisor's replay harness before reporting availability numbers."}, {"id": "benchmark_v4_readme_fed_grounding", "label": "Fed Grounding Files (A1-A6 flattened artifacts as run context)", "file_type": "concept", "source_file": "benchmark_v4/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "grounding/ holds A1-A6 flattened artifact grounding files fed as context in matched/heldout/uncovered runs; extractions/ holds the structured Opus grep-verified extractions serving as gold provenance."}], "edges": [{"source": "benchmark_v4_readme", "target": "readme_from_lookup_to_reasoning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "benchmark_v4/README.md", "source_location": null, "weight": 1.0}, {"source": "benchmark_v4_harness_validate_golds", "target": "benchmark_v4_readme_gold_admission_gate", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "benchmark_v4/README.md", "source_location": null, "weight": 1.0}, {"source": "benchmark_v4_harness_tier_assign", "target": "benchmark_v4_readme_computed_tiers", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "benchmark_v4/README.md", "source_location": null, "weight": 1.0}, {"source": "benchmark_v4_harness_runner", "target": "benchmark_v4_readme_h0_h1_instrument", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "benchmark_v4/README.md", "source_location": null, "weight": 1.0}, {"source": "benchmark_v4_readme_h0_h1_instrument", "target": "benchmark_v4_benchmark_v4_