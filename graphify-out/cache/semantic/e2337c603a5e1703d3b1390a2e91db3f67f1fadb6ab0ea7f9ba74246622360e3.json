{"nodes": [{"id": "rag_docs_chameleon_readme", "label": "Chameleon Docs Assistant README", "file_type": "document", "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rag_docs_chameleon_rag", "label": "rag.py \u2014 RAG Pipeline / CLI", "file_type": "code", "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rag_docs_chameleon_build_index", "label": "build_index.py \u2014 Index Builder", "file_type": "code", "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rag_docs_chameleon_loader", "label": "loader.py \u2014 Documentation Source Fetchers (SOURCES dict)", "file_type": "code", "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rag_docs_chameleon_readme_retrieval_pipeline", "label": "FAISS + BGE Retrieval Pipeline", "file_type": "concept", "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Questions embedded with BAAI/bge-large-en-v1.5, matched against child chunks in FAISS, drawn from a per-source-type balanced pool, re-ranked by a cross-encoder; answers generated by Meta-Llama-3.3-70B-Instruct strictly from retrieved context."}, {"id": "rag_docs_chameleon_readme_parent_child_chunking", "label": "Parent-Child Chunking", "file_type": "rationale", "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small (~400 char) child chunks give retrieval precision; large (~2000 char) parent chunks give the model coherent context. Child chunks are prefixed with a [source_type: page title] header so embeddings capture document-level context."}, {"id": "rag_docs_chameleon_readme_cross_encoder_reranker", "label": "Cross-Encoder Reranking (BAAI/bge-reranker-base)", "file_type": "concept", "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaced MMR-only retrieval; reranks a per-type balanced candidate pool by (query, chunk) relevance and discards chunks below a minimum score."}, {"id": "rag_docs_chameleon_readme_tiered_context_assembly", "label": "Tiered Context Assembly (PRIMARY vs SUPPLEMENTARY)", "file_type": "rationale", "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Official docs (readthedocs + python-chi) go in a PRIMARY DOCUMENTATION section, blog/forum in SUPPLEMENTARY CONTEXT; the LLM is instructed to ground answers in primary documentation first and use supplementary content only for examples and gap-filling."}, {"id": "rag_docs_chameleon_readme_two_store_architecture", "label": "Two-Store Architecture (planned)", "file_type": "rationale", "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split the FAISS index into a primary store (readthedocs, python-chi) and a supplemental store (curated blog posts, Trovi) to eliminate heuristic source-type balancing and give cleaner control over what the model treats as authoritative; would also make forum/GitBook sources safe to re-include."}, {"id": "rag_docs_chameleon_readme_mcp_server_plan", "label": "Chameleon API MCP Server (planned live-data integration)", "file_type": "concept", "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Model Context Protocol server wrapping Chameleon REST APIs (Blazar reservations, node availability, hardware discovery) to answer dynamic questions; architecturally distinct from RAG \u2014 tool use rather than document retrieval \u2014 and requires designing an authentication flow."}, {"id": "rag_docs_chameleon_readme_feedback_logging", "label": "Feedback & Session Logging (session_log.jsonl + feedback.db)", "file_type": "concept", "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every query/answer appended to session_log.jsonl; thumbs-up/down ratings with failure categories stored in SQLite feedback.db, summarised by feedback_report.py. These are the primary signals that the index is stale."}, {"id": "rag_docs_chameleon_readme_index_build_pipeline", "label": "Two-Phase Fetch-then-Embed Index Build", "file_type": "rationale", "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each source is fetched independently and checkpointed to _fetch_cache/ before anything is embedded, so a single source failure does not abort the run; the new index is built in a temp directory and atomically swapped into place only after the full build succeeds."}, {"id": "rag_docs_chameleon_readme_eval_pipeline", "label": "RAG Eval Pipeline (golden question set, eval/)", "file_type": "concept", "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Golden question set scored via run_pipeline.py and score.py; scoring uses retrieval diagnostics (formerly cosine similarity of BGE embeddings) appended to CSV for cross-run comparison."}], "edges": [{"source": "rag_docs_chameleon_build_index", "target": "rag_docs_chameleon_loader", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_docs_chameleon_build_index", "target": "rag_docs_chameleon_readme_index_build_pipeline", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_docs_chameleon_rag", "target": "rag_docs_chameleon_readme_retrieval_pipeline", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_docs_chameleon_readme_parent_child_chunking", "target": "rag_docs_chameleon_readme_retrieval_pipeline", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_docs_chameleon_readme_cross_encoder_reranker", "target": "rag_docs_chameleon_readme_retrieval_pipeline", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_docs_chameleon_readme_tiered_context_assembly", "target": "rag_docs_chameleon_readme_retrieval_pipeline", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_docs_chameleon_readme_two_store_architecture", "target": "rag_docs_chameleon_readme_tiered_context_assembly", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_docs_chameleon_readme", "target": "rag_docs_chameleon_roadmap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_docs_chameleon_web_rag", "target": "rag_docs_chameleon_readme_feedback_logging", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_docs_chameleon_readme_eval_pipeline", "target": "benchmark_v4_readme", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "weight": 1.0}, {"source": "rag_docs_chameleon_readme_mcp_server_plan", "target": "rag_docs_chameleon_roadmap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RAG-docs-chameleon/README.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "rag_retrieval_quality_stack", "label": "RAG Retrieval Quality Stack", "nodes": ["rag_docs_chameleon_readme_retrieval_pipeline", "rag_docs_chameleon_readme_parent_child_chunking", "rag_docs_chameleon_readme_cross_encoder_reranker", "rag_docs_chameleon_readme_tiered_context_assembly", "rag_docs_chameleon_roadmap_reranker_threshold"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "RAG-docs-chameleon/README.md"}]}