# --- Secrets: never commit ---
vivek.pem
*.pem
.env

# --- Nested git repo (own history + remote; see README) ---
/RAG-docs-chameleon/

# --- Virtualenvs (also self-ignored; belt and braces) ---
# Both forms: the trailing slash matches the real directory, the bare
# name matches the per-project symlinks pointing at the root venv.
.venv/
.venv
venv/
rag_env/

# --- Python caches / build ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# --- macOS cruft ---
.DS_Store

# --- Claude Code machine-local settings ---
**/.claude/settings.local.json

# --- corpus_v2 fetch cache: 200 upstream clones, ~8 GB, reproducible from
#     fetch_state.jsonl content hashes ---
benchmark/corpus_v2/cache/

# --- Chameleon app-credential openrc files, one per site. Secrets. ---
credentials/

# --- Published tree is execution code + the data needed to run it. Everything
#     below is generated, reproducible, or narrative, so it stays local. ---

# Generated by the tools in this repo
# score_runs.py, make_paste_kit.py
benchmark/exports/
# make_run_prompts.py, from items/ + fed_sets
benchmark/prompts/
# graphify update .
graphify-out/
.graphifyignore
chi-edge-advisor/presentation_assets/
chi-edge-advisor/data/

# Collected experiment data, not code: 556 model answers
benchmark/runs/
# Live-verification output: what a run against the real testbed produced. The
# drivers beside them (live_api_probe.py, live_gold_batch.py) and the unexecuted
# verify_golds_live.ipynb are tracked; the state they emit is not. An executed
# notebook also carries its own outputs, so it is output by the same rule.
benchmark/notebooks/live_probe_state.json
benchmark/notebooks/live_verification_results.json
benchmark/notebooks/live_gold_batch_state_*.json
benchmark/notebooks/*_executed.ipynb
# Superseded arms + the advisor component test, kept out of runs/ so the scorer
# never reads them as a condition (see tools/score_runs.py SYSTEM_ORDER).
benchmark/runs_archive/

# Pre-Tejas .env backup: template-shaped, no keys, but not part of the tree.
chi-edge-advisor/.env.bak-*

# Corpus triage output; corpus_v2/tools/ that produces it is tracked
benchmark/corpus_v2/README.md
benchmark/corpus_v2/catalog.jsonl
benchmark/corpus_v2/fetch_state.jsonl
benchmark/corpus_v2/manifest.tsv
benchmark/corpus_v2/phases.tsv
benchmark/corpus_v2/parity/

# Trovi compendium: 1.4 MB of scraped records
benchmark/compendium/

# Reports and working notes. README.md and PROJECT_GUIDE.md are the docs.
audit/
docs/README.md
docs/architecture/
docs/archive/
docs/usage/
benchmark/reports/
# NOT benchmark/README.md: it is the package readme that pyproject.toml
# declares, so ignoring it shipped a description-less package over
# `pip install git+...` while local wheel builds looked fine.
benchmark/BENCHMARK_REPORT.md
benchmark/benchmark_v3.xlsx
chi-edge-advisor/README.md
# Handoff prompts: each one opens "paste this whole file as your opening
# prompt", so they are session scaffolding rather than documentation. The
# reasoning they carry is in benchmark_v4_decisions.md, which IS tracked.
benchmark/*_HANDOFF.md
chi-edge-advisor/*_HANDOFF.md
benchmark/CHAMELEON_WING_FINAL.md

# Chatbot session transcripts dropped at the repo root
20*-chameleon-chatbot-*.txt
# Harness leftovers dumped at the repo root by the bpftime uprobe benchmark:
# 80 empty files named test-<arm>-<n>_--http.txt. Not ours, not data.
/test-*.txt
# Slide decks and other binaries parked at the root
/*.pdf

# --- Agent instruction files. Not part of the published work. ---
CLAUDE.md
**/CLAUDE.md
.claude/

# Wheel build artifacts
benchmark/dist/
benchmark/build/
benchmark/*.egg-info/
