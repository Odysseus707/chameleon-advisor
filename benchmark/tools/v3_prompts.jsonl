28
{"id": "P01", "cat": "Setup", "diff": "E", "axis": "ACT", "prompt": "Show the minimal python-chi setup to target CHI@Edge and select my project.", "trap": "chi.use_site vs context; wrong site string; forgets project.", "gold": "context.choose_site(default=\"CHI@Edge\"); context.choose_project()  — or chi.use_site(\"CHI@Edge\") + chi.set(\"project_name\", ...)", "art": "A1/A2"}
{"id": "P02", "cat": "Reservation", "diff": "E", "axis": "ACT", "prompt": "Reserve one Raspberry Pi 4 on CHI@Edge for 2 hours.", "trap": "Bare-metal add_node_reservation / node_type.", "gold": "lease.Lease(\"n\", duration=timedelta(hours=2)); .add_device_reservation(machine_type=\"raspberrypi4-64\", amount=1); .submit()", "art": "A3"}
{"id": "P03", "cat": "Reservation", "diff": "M", "axis": "ACT", "prompt": "Reserve a Pi on CHI@Edge and get the reservation_id I'll pass to a container.", "trap": "Never retrieves the id; wrong attribute.", "gold": "After submit: my_lease.device_reservations[0][\"id\"]", "art": "A2"}
{"id": "P04", "cat": "Reservation", "diff": "M", "axis": "ACT", "prompt": "Reserve 3 Raspberry Pis on CHI@Edge of the same type in one lease.", "trap": "Node reservation; count mishandled.", "gold": ".add_device_reservation(machine_type=\"raspberrypi4-64\", amount=3)", "art": "A3"}
{"id": "P05", "cat": "Container", "diff": "E", "axis": "ACT", "prompt": "Launch a basic Ubuntu container on a reserved Pi on CHI@Edge.", "trap": "create_server (VM) instead of a container.", "gold": "container.Container(name, image_ref=\"ubuntu:22.04\", reservation_id=rid).submit()  (name: no underscores — k8s)", "art": "A2"}
{"id": "P06", "cat": "Container", "diff": "E", "axis": "VALIDATE", "prompt": "My container on CHI@Edge exits immediately. Make it stay running so I can exec into it.", "trap": "No long-running command given.", "gold": "Add command=[\"sleep\",\"infinity\"] to Container(...)", "art": "A2"}
{"id": "P07", "cat": "Container", "diff": "M", "axis": "ACT", "prompt": "Expose port 8080 on my CHI@edge container and give it a public IP.", "trap": "exposed_ports string format; FIP omitted; nova idioms.", "gold": "exposed_ports=[8080] in the container; then chi.container.associate_floating_ip(c.uuid)", "art": "A1"}
{"id": "P08", "cat": "Container", "diff": "M", "axis": "ACT", "prompt": "Run 'ls /app' inside the running container in CHI@Edge and capture the output.", "trap": "Hallucinated exec API; ignores tuple return.", "gold": "result, code = my_container.execute(\"ls /app\")", "art": "A2"}
{"id": "P09", "cat": "Container", "diff": "E", "axis": "ACT", "prompt": "Upload model.pt into the CHI@Edge container, then download results.csv back out.", "trap": "Invented up/download names.", "gold": "my_container.upload(\"model.pt\", \"/app/\"); my_container.download(\"/app/results.csv\", \".\")", "art": "A2"}
{"id": "P10", "cat": "Container", "diff": "E", "axis": "ACT", "prompt": "Tear everything down: remove the CHI@Edge container and free the device.", "trap": "Invented teardown; leaves the lease.", "gold": "my_container.delete(); my_lease.delete()", "art": "A2"}
{"id": "P11", "cat": "SSH / Dev", "diff": "M", "axis": "ACT", "prompt": "Launch an SSH-enabled container on a reserved Pi and tell me how to connect.", "trap": "Doesn't know edge_ssh_image; wrong port type.", "gold": "Container(image_ref=\"ghcr.io/chameleoncloud/edge_ssh_image:latest\", exposed_ports=[22], ...); associate_floating_ip -> ssh root@<ip>", "art": "A1"}
{"id": "P12", "cat": "SSH / Dev", "diff": "M", "axis": "VALIDATE", "prompt": "Inject my public key so I can SSH in as root.", "trap": "Wrong key path / mechanism.", "gold": "upload pubkey to /root/.ssh/; execute chmod 600 authorized_keys; cat key >> /root/.ssh/authorized_keys", "art": "A1"}
{"id": "P13", "cat": "SSH / Dev", "diff": "E", "axis": "VALIDATE", "prompt": "Which image and exposed port do I need for SSH on CHI@Edge?", "trap": "Generic sshd build; misses prebuilt image.", "gold": "ghcr.io/chameleoncloud/edge_ssh_image:latest, exposed_ports=[22]", "art": "A1"}
{"id": "P14", "cat": "SSH / Dev", "diff": "H", "axis": "REASON", "prompt": "End-to-end: get me a Pi on CHI@Edge I can hit with VS Code Remote-SSH.", "trap": "Drops a link in reserve->image->key->FIP chain.", "gold": "reserve Pi -> Container(edge_ssh_image, exposed_ports=[22]) -> upload+authorize key -> associate_floating_ip -> VS Code to root@ip", "art": "A1"}
{"id": "P15", "cat": "Peripherals · Camera", "diff": "M", "axis": "READ", "prompt": "Find which Pis have a camera attached and reserve one.", "trap": "Can't filter by peripheral; guesses device.", "gold": "hardware.get_devices(filter_reserved=True, device_type=\"raspberrypi4-64\"); pick device_name starting \"iot-rpi4-picam\"; add_device_reservation(devices=[dev])", "art": "A2"}
{"id": "P16", "cat": "Peripherals · Camera", "diff": "M", "axis": "VALIDATE", "prompt": "Launch a container with the Pi camera enabled.", "trap": "Omits device_profiles; guesses the profile name.", "gold": "Container(image_ref=\"ghcr.io/chameleoncloud/edge-picamera-image:latest\", device_profiles=[\"pi_libcamera\"], command=[\"sleep\",\"infinity\"])", "art": "A2"}
{"id": "P17", "cat": "Peripherals · Camera", "diff": "M", "axis": "ACT", "prompt": "Capture a 1080p still from the Pi Camera and download it.", "trap": "Made-up capture API; no download.", "gold": "execute(\"rpicam-still --nopreview --output /app/x.png --width 1920 --height 1080\"); download(\"/app/x.png\", \".\")", "art": "A2"}
{"id": "P18", "cat": "Peripherals · Camera", "diff": "M", "axis": "ACT", "prompt": "Record a 5-second 1080p video from the camera.", "trap": "Wrong tool / flags.", "gold": "execute(\"rpicam-vid --nopreview -t 5000 --output /app/v.mp4 --width 1920 --height 1080 --framerate 24\")", "art": "A2"}
{"id": "P19", "cat": "Peripherals · Camera", "diff": "E", "axis": "VALIDATE", "prompt": "Verify the camera is detected inside the container.", "trap": "Invents a detection command.", "gold": "execute(\"rpicam-hello --nopreview --list-cameras\")", "art": "A2"}
{"id": "P20", "cat": "Peripherals · Sense HAT", "diff": "M", "axis": "ACT", "prompt": "Reserve the specific device that has the Sense HAT attached.", "trap": "Reserves any device; ignores device_name.", "gold": "add_device_reservation(amount=1, machine_type=\"raspberrypi4-64\", device_name=\"iot-rpi4-picam3\")", "art": "A3"}
{"id": "P21", "cat": "Peripherals · Sense HAT", "diff": "M", "axis": "VALIDATE", "prompt": "Launch a container with the Sense HAT enabled.", "trap": "Omits / guesses the device profile.", "gold": "Container(image_ref=\"ghcr.io/chameleoncloud/edge_sensehat_image:latest\", device_profiles=[\"pi_sensehat\"], command=[\"-c\",\"sleep infinity\"])", "art": "A3"}
{"id": "P22", "cat": "Peripherals · Sense HAT", "diff": "M", "axis": "ACT", "prompt": "Read temperature, humidity and pressure from the Sense HAT.", "trap": "Assumes host access; wrong library.", "gold": "execute python: from sense_hat import SenseHat; .get_temperature_from_humidity()/.get_humidity()/.get_pressure()", "art": "A3"}
{"id": "P23", "cat": "Peripherals · Sense HAT", "diff": "M", "axis": "VALIDATE", "prompt": "From inside the container, list the I2C addresses to debug the sensor bus.", "trap": "No I2C access path.", "gold": "execute(\"i2cdetect -y 1\")  (needs the pi_sensehat profile exposing /dev/i2c-*)", "art": "A3"}
{"id": "P24", "cat": "Peripherals · Sense HAT", "diff": "E", "axis": "VALIDATE", "prompt": "Which device profile and image do I use for Sense HAT / GPIO work?", "trap": "Guesses the profile string.", "gold": "device_profiles=[\"pi_sensehat\"], image ghcr.io/chameleoncloud/edge_sensehat_image:latest", "art": "A3"}
{"id": "P25", "cat": "Availability", "diff": "M", "axis": "READ", "prompt": "List which CHI@Edge device types currently exist and are reservable.", "trap": "Lists bare-metal flavors; invents an endpoint.", "gold": "hardware.get_devices(filter_reserved=True); inspect device_type / device_name (Blazar-backed).", "art": "A2"}
{"id": "P26", "cat": "Availability", "diff": "H", "axis": "READ", "prompt": "Before reserving on CHI@Edge, check whether a given device is free right now.", "trap": "Claims it has no live state; fabricates an API.", "gold": "hardware.get_devices(filter_reserved=True, device_type=\"raspberrypi4-64\") — a free device in the result means it's available.", "art": "A2"}
{"id": "P27", "cat": "Availability", "diff": "M", "axis": "READ", "prompt": "How do I find which device_profiles a device supports?", "trap": "Guesses a call.", "gold": "The artifact README documents the device's profile (e.g. pi_libcamera, pi_sensehat); pass it via device_profiles.", "art": "A3"}
{"id": "P28", "cat": "Pitfall trap", "diff": "H", "axis": "VALIDATE", "prompt": "Convert my CHI@UC bare-metal script (add_node_reservation, node_type='compute_skylake', create_server) to run on CHI@Edge.", "trap": "Keeps node/flavor/server.", "gold": "Swap to device reservation (add_device_reservation/machine_type) + container.Container(image_ref, reservation_id).submit(); drop flavor/keypair/network; site CHI@Edge.", "art": "A1"}
