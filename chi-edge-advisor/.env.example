# chi-edge-advisor configuration. Copy to `.env` and fill in as needed.
# Real environment variables always override this file.

# --- Availability backend (NEVER hardcoded in code; selected here) ----------
# reference_api : static reference-API catalog only (NO live reservation state)
# blazar        : live host/lease state via python-chi  (recommended for real use)
AVAILABILITY_BACKEND=blazar

# --- Reference / discovery API ----------------------------------------------
REFERENCE_API_BASE=https://api.chameleoncloud.org
EDGE_SITE_UID=edge

# --- Chameleon / Blazar (python-chi) ----------------------------------------
CHI_SITE_NAME=CHI@Edge
CHI_PROJECT_NAME=CHI-261560
# Credential acquisition is out of scope here; python-chi picks up the usual
# OpenStack/Chameleon env (OS_* vars / clouds.yaml) or JupyterHub context.

# --- LLM reasoner -----------------------------------------------------------
# tejas     : OpenAI-compatible Tejas AI endpoint (default) -> Llama 3.3 70B
# ollama    : local Ollama server -> no API key, no network, no cost
# anthropic : hosted Anthropic API (dev-time, paid)
LLM_PROVIDER=ollama
TEJAS_BASE_URL=https://ai.tejas.tacc.utexas.edu/v1
TEJAS_MODEL=Meta-Llama-3.3-70B-Instruct
# TEJAS_API_KEY=fill-me-in

# Local Ollama (used when LLM_PROVIDER=ollama). Needs `ollama serve` running and
# the model pulled (`ollama pull llama3`). Set OLLAMA_MODEL to any name shown by
# `ollama list` -- e.g. qwen2.5:7b-instruct reasons better for JSON output.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ANTHROPIC_API_KEY=fill-me-in
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Embeddings (mirror RAG-docs-chameleon) ---------------------------------
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# --- Paths / behavior -------------------------------------------------------
# GROUNDING_DIR=../grounding
# DATA_DIR=./data
# ADVISOR_LOG_PATH=./data/runs.jsonl
# HTTP_TIMEOUT=20

# Force the dependency-free offline path (hashing embedder, heuristic reasoner)
# even when the real stack is installed. Handy for credential-free demos/tests.
# ADVISOR_OFFLINE=1
